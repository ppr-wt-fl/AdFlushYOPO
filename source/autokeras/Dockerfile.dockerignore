# BuildKit picks this file over the repo-root .dockerignore when the build is
#   docker build -f source/autokeras/Dockerfile .
# (requires BuildKit / `docker buildx`, the default in modern Docker).
#
# The repo root holds ~2 GB of CSVs (dataset/ included -- it's bind-mounted
# at `docker run` time, not copied into the image) plus the browser
# extensions, assets, and the rest of source/. Allowlist just what the
# Dockerfile COPYs so the build context stays small.

# ignore everything...
**

# ...then re-include exactly what the Dockerfile needs
!source/autokeras/requirements_autokeras.txt
!source/autokeras/train_autokeras.py
!source/tfjs_validate/package.json
!source/tfjs_validate/validate.js
